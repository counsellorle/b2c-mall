# ============================================================
# B2C 商城 Docker 部署 —— 环境变量模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env 后按实际情况修改
#         cp .env.example .env
# 警告：.env 含敏感信息，已被 .gitignore 忽略，切勿提交到仓库
#       本文件只放占位符/安全默认值，可以安全提交
# ============================================================

# ---------------- MySQL ----------------
# root 用户密码（生产环境务必改成强密码，不要用示例值）
MYSQL_ROOT_PASSWORD=change_me_please
MYSQL_DATABASE=b2c_mall

# ---------------- Nacos ----------------
# 注册/配置中心地址。
#   容器内部署：保持服务名 nacos:8848 即可
#   连接外部实例：改成真实地址，例如 your-nacos-host:8848
NACOS_ADDR=nacos:8848
# 命名空间 ID。public 命名空间留空；外部实例填其 namespace ID
NACOS_NAMESPACE=

# ---------------- Redis ----------------
#   容器内部署：保持服务名 redis 即可
#   连接外部实例：改成真实地址
REDIS_HOST=redis
REDIS_PORT=6379
